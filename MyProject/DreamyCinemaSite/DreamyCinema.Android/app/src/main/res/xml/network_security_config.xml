<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The server address is user-configurable, so HTTP is allowed for trusted LAN use. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
